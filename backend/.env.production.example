# PlayArena backend — production environment (example). Copy to .env.production
# and fill secrets from your secret store. NEVER commit the filled file.
# The app refuses to start in production if any required value is missing/invalid
# (see config.validate): JWT_SECRET >= 32 chars, FRONTEND_URL https://,
# EMAIL_PROVIDER not log/noop, APP_INTERNAL_PORT != APP_PORT.

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
# Internal observability server (/metrics, /ready, /live). MUST differ from
# APP_PORT and MUST NOT be exposed publicly — scraped only on the private network.
APP_INTERNAL_PORT=9090
PPROF_ENABLED=false

# ── Database (managed Postgres with PITR — NOT self-hosted for the pilot) ──────
# Neon / Supabase / RDS / DO Managed PG. sslmode=require is mandatory in prod.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/playarena?sslmode=require

# ── Secrets (generate fresh; do not reuse dev values) ─────────────────────────
# openssl rand -base64 48   (must be >= 32 chars)
JWT_SECRET=__GENERATE_A_LONG_RANDOM_SECRET__
# openssl rand -base64 32
WEBHOOK_SECRET_KEY=__GENERATE_A_RANDOM_SECRET__

# ── URLs / CORS ───────────────────────────────────────────────────────────────
# Frontend origin (https). Used to build verification/reset email links AND
# validated to be https in production.
FRONTEND_URL=https://app.playarena.app
# Comma-separated allowed browser origins for the authed API (CORS).
CORS_ALLOWED_ORIGINS=https://app.playarena.app

# ── Reverse proxy / real client IP ────────────────────────────────────────────
# CIDRs of trusted proxies (Caddy on the docker bridge). The app only rewrites
# RemoteAddr from forwarding headers for these — required for correct per-IP
# rate limiting and audit logs behind Cloudflare→Caddy. Use your docker subnet.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# ── Email (Resend SMTP recommended; or SES) ───────────────────────────────────
# Verify SPF/DKIM/DMARC for the sending domain before the pilot.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@playarena.app
EMAIL_FROM_NAME=PlayArena
# Resend SMTP: host=smtp.resend.com port=587 user=resend password=<API key>
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=__RESEND_API_KEY__
EMAIL_SMTP_TLS=true
# --- Alternative: AWS SES (EMAIL_PROVIDER=ses) ---
# EMAIL_PROVIDER=ses
# EMAIL_SES_REGION=ap-south-1
# EMAIL_SES_ACCESS_KEY=__SES_ACCESS_KEY__
# EMAIL_SES_SECRET_KEY=__SES_SECRET_KEY__

# ── Media storage (Cloudflare R2 recommended; local volume acceptable for pilot)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_LOCAL_BASE_URL=https://api.playarena.app/media/files
# --- Alternative: Cloudflare R2 / S3 (STORAGE_BACKEND=s3) ---
# STORAGE_BACKEND=s3
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=playarena-media
# STORAGE_S3_ACCESS_KEY=__R2_ACCESS_KEY__
# STORAGE_S3_SECRET_KEY=__R2_SECRET_KEY__
# STORAGE_CDN_BASE_URL=https://media.playarena.app

# ── Rate limits (defaults are sane; raise bursts for venue NAT if needed) ──────
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_RPS=10
# RATE_LIMIT_AUTH_BURST=20
# RATE_LIMIT_WRITE_RPS=30
# RATE_LIMIT_WRITE_BURST=60

# ── Feature flags (PHI-1A: keep player persona OFF) ───────────────────────────
GP_PLAYER_PERSONA_ENABLED=false
