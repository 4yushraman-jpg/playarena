# PlayArena origin reverse proxy (PHI-1A).
#
# Model: Cloudflare proxies DNS (orange cloud) and terminates client TLS at the
# edge; this Caddy terminates ORIGIN TLS using a Cloudflare Origin Certificate
# (SSL/TLS mode = Full (strict)). Caddy trusts Cloudflare so per-IP rate limiting
# and audit logs see the real client IP, then forwards to the api/web containers.
#
# Replace example.app hostnames. Place the Origin Certificate at
# deploy/certs/origin.pem and its key at deploy/certs/origin.key.
#
# Alternative (simpler, no inbound ports / no origin cert): run `cloudflared`
# (Cloudflare Tunnel) to api:8080 and web:3000 and skip this proxy entirely.

{
	# Trust Cloudflare's edge so the real client IP is taken from CF headers.
	# Keep this list current from https://www.cloudflare.com/ips/ (or use the
	# caddy-cloudflare module). Without it, every request appears to come from
	# Cloudflare and per-IP limits/audit are wrong.
	servers {
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Shared hardening + real-IP forwarding for upstream apps.
(common) {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ── Backend API ───────────────────────────────────────────────────────────────
api.example.app {
	tls /certs/origin.pem /certs/origin.key
	import common
	# Pass the real client IP (Caddy derives it from trusted Cloudflare headers).
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
	# The internal observability port (9090) is intentionally never proxied.
}

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
app.example.app {
	tls /certs/origin.pem /certs/origin.key
	import common
	reverse_proxy web:3000
}
